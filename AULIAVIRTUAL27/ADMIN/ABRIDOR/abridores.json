[
  {
    "id": 501,
    "ext": "pdf",
    "name": "Visor PDF Protegido (Sin descarga)",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>{{FILE_NAME}}</title>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js\"></script>\n  <style>\n    :root {\n      --bg-main: #0b1120;\n      --bg-bar: #111827;\n      --bg-panel: #1e293b;\n      --border: #334155;\n      --accent: #3b82f6;\n      --accent-hover: #2563eb;\n      --text: #f8fafc;\n      --text-muted: #94a3b8;\n    }\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: 'Inter', system-ui, -apple-system, sans-serif;\n      background: var(--bg-main);\n      color: var(--text);\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n      user-select: none;\n    }\n\n    /* Barra de progreso de lectura */\n    .progress-track {\n      height: 3px;\n      width: 100%;\n      background: #1e293b;\n    }\n    .progress-fill {\n      height: 100%;\n      width: 0%;\n      background: linear-gradient(90deg, #3b82f6, #38bdf8);\n      transition: width 0.25s ease;\n    }\n\n    /* Barra superior */\n    .toolbar {\n      background: var(--bg-bar);\n      padding: 8px 14px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid var(--border);\n      gap: 10px;\n      flex-wrap: wrap;\n      z-index: 20;\n    }\n    .group {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    .file-title {\n      font-size: 13px;\n      font-weight: 700;\n      max-width: 210px;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      color: #e2e8f0;\n    }\n    button {\n      background: var(--bg-panel);\n      color: var(--text);\n      border: 1px solid #334155;\n      padding: 6px 10px;\n      border-radius: 8px;\n      font-size: 12px;\n      font-weight: 600;\n      cursor: pointer;\n      display: inline-flex;\n      align-items: center;\n      gap: 5px;\n      transition: all 0.15s ease;\n    }\n    button:hover:not(:disabled) {\n      background: #334155;\n      border-color: #475569;\n    }\n    button:disabled { opacity: 0.35; cursor: not-allowed; }\n    button.active {\n      background: var(--accent);\n      border-color: var(--accent);\n      color: #fff;\n    }\n\n    .page-pill {\n      background: #0f172a;\n      border: 1px solid var(--border);\n      padding: 4px 10px;\n      border-radius: 8px;\n      font-size: 12px;\n      font-weight: 600;\n      display: flex;\n      align-items: center;\n      gap: 4px;\n    }\n    .page-pill input {\n      width: 36px;\n      background: transparent;\n      border: none;\n      color: #38bdf8;\n      font-weight: 700;\n      text-align: center;\n      font-size: 12px;\n      outline: none;\n    }\n\n    /* Buscador desplegable */\n    .search-bar {\n      display: none;\n      background: #1e293b;\n      padding: 8px 16px;\n      border-bottom: 1px solid var(--border);\n      align-items: center;\n      gap: 8px;\n    }\n    .search-bar.open { display: flex; }\n    .search-bar input {\n      background: #0f172a;\n      border: 1px solid #475569;\n      color: white;\n      padding: 6px 12px;\n      border-radius: 8px;\n      font-size: 12px;\n      width: 240px;\n      outline: none;\n    }\n    .search-bar input:focus { border-color: var(--accent); }\n    .search-status { font-size: 12px; color: var(--text-muted); }\n\n    /* Área principal */\n    .workspace {\n      flex: 1;\n      display: flex;\n      overflow: hidden;\n      position: relative;\n    }\n\n    /* Panel de miniaturas */\n    .sidebar {\n      width: 175px;\n      background: #0f172a;\n      border-right: 1px solid var(--border);\n      overflow-y: auto;\n      padding: 12px;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n      transition: width 0.2s ease, padding 0.2s ease;\n    }\n    .sidebar.collapsed {\n      width: 0;\n      padding: 0;\n      border: none;\n      overflow: hidden;\n    }\n    .thumb-card {\n      background: #1e293b;\n      border: 2px solid transparent;\n      border-radius: 8px;\n      padding: 6px;\n      cursor: pointer;\n      text-align: center;\n      transition: all 0.15s;\n    }\n    .thumb-card:hover { border-color: #64748b; }\n    .thumb-card.active {\n      border-color: var(--accent);\n      background: #1e3a8a44;\n    }\n    .thumb-card canvas {\n      width: 100%;\n      height: auto;\n      border-radius: 4px;\n      background: white;\n      display: block;\n    }\n    .thumb-label {\n      font-size: 11px;\n      color: var(--text-muted);\n      margin-top: 5px;\n      font-weight: 600;\n    }\n\n    /* Visor central */\n    .viewer-container {\n      flex: 1;\n      overflow: auto;\n      display: flex;\n      justify-content: center;\n      align-items: flex-start;\n      padding: 28px;\n      background-image: radial-gradient(#1e293b 1.2px, transparent 1.2px);\n      background-size: 22px 22px;\n      position: relative;\n    }\n\n    .page-wrapper {\n      position: relative;\n      display: none;\n      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);\n      border-radius: 6px;\n      overflow: hidden;\n      transition: filter 0.25s ease;\n    }\n    .page-wrapper.night-mode {\n      filter: invert(0.9) hue-rotate(180deg) contrast(0.95);\n    }\n    #pdf-canvas {\n      display: block;\n      background: white;\n    }\n    #draw-canvas {\n      position: absolute;\n      top: 0;\n      left: 0;\n      pointer-events: none;\n    }\n    #draw-canvas.drawing-active {\n      pointer-events: auto;\n      cursor: crosshair;\n    }\n\n    /* Estado de carga */\n    .loading {\n      margin: auto;\n      text-align: center;\n      color: var(--text-muted);\n      font-size: 14px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 12px;\n    }\n    .spinner {\n      width: 34px;\n      height: 34px;\n      border: 3px solid #334155;\n      border-top-color: var(--accent);\n      border-radius: 50%;\n      animation: spin 0.8s linear infinite;\n    }\n    @keyframes spin { to { transform: rotate(360deg); } }\n\n    /* Toast flotante */\n    .toast {\n      position: fixed;\n      bottom: 18px;\n      right: 18px;\n      background: #1e293b;\n      border: 1px solid #475569;\n      color: #f8fafc;\n      padding: 8px 14px;\n      border-radius: 10px;\n      font-size: 12px;\n      font-weight: 600;\n      opacity: 0;\n      transform: translateY(10px);\n      transition: all 0.2s;\n      pointer-events: none;\n      z-index: 50;\n    }\n    .toast.show { opacity: 1; transform: translateY(0); }\n\n    @media (max-width: 700px) {\n      .sidebar { position: absolute; z-index: 15; height: 100%; }\n      .file-title { max-width: 120px; }\n    }\n  </style>\n</head>\n<body oncontextmenu=\"return false;\">\n\n  <div class=\"progress-track\"><div class=\"progress-fill\" id=\"progress-fill\"></div></div>\n\n  <!-- Barra de herramientas principal -->\n  <div class=\"toolbar\">\n    <div class=\"group\">\n      <button id=\"toggle-sidebar-btn\" onclick=\"toggleSidebar()\" title=\"Mostrar/Ocultar miniaturas\">📑 Páginas</button>\n      <span class=\"file-title\" title=\"{{FILE_NAME}}\">📄 {{FILE_NAME}}</span>\n    </div>\n\n    <div class=\"group\">\n      <button id=\"prev-page\" onclick=\"onPrevPage()\" disabled title=\"Página anterior (←)\">◀</button>\n      <div class=\"page-pill\">\n        <input type=\"number\" id=\"page-input\" min=\"1\" value=\"1\" onchange=\"jumpToPage(this.value)\">\n        <span>/ <span id=\"page-count\">-</span></span>\n      </div>\n      <button id=\"next-page\" onclick=\"onNextPage()\" disabled title=\"Página siguiente (→)\">▶</button>\n    </div>\n\n    <div class=\"group\">\n      <button onclick=\"zoomOut()\" title=\"Alejar (-)\">➖</button>\n      <span id=\"zoom-label\" style=\"font-size:12px;font-weight:700;min-width:42px;text-align:center;\">125%</span>\n      <button onclick=\"zoomIn()\" title=\"Acercar (+)\">➕</button>\n      <button onclick=\"fitWidth()\" title=\"Ajustar al ancho\">↔ Ancho</button>\n      <button onclick=\"rotateDoc()\" title=\"Rotar 90°\">↻</button>\n    </div>\n\n    <div class=\"group\">\n      <button id=\"search-toggle-btn\" onclick=\"toggleSearch()\" title=\"Buscar texto (Ctrl+F)\">🔍 Buscar</button>\n      <button id=\"night-btn\" onclick=\"toggleNightMode()\" title=\"Modo lectura nocturna\">🌙 Noche</button>\n      <button id=\"pen-btn\" onclick=\"toggleHighlighter()\" title=\"Subrayador de estudio\">🖍️ Subrayar</button>\n      <button id=\"clear-pen-btn\" onclick=\"clearHighlights()\" style=\"display:none;\" title=\"Borrar trazos\">🧹</button>\n      <button onclick=\"toggleFullscreen()\" title=\"Pantalla completa\">⛶</button>\n    </div>\n  </div>\n\n  <!-- Barra de búsqueda -->\n  <div class=\"search-bar\" id=\"search-bar\">\n    <input type=\"text\" id=\"search-input\" placeholder=\"Buscar palabra en el documento...\" onkeyup=\"if(event.key==='Enter') runSearch()\">\n    <button onclick=\"runSearch()\">Buscar</button>\n    <button onclick=\"prevMatch()\" id=\"prev-match-btn\" disabled>↑</button>\n    <button onclick=\"nextMatch()\" id=\"next-match-btn\" disabled>↓</button>\n    <span class=\"search-status\" id=\"search-status\"></span>\n    <button onclick=\"toggleSearch()\" style=\"margin-left:auto;\">✕</button>\n  </div>\n\n  <!-- Espacio de trabajo -->\n  <div class=\"workspace\">\n    <aside class=\"sidebar\" id=\"sidebar\"></aside>\n\n    <main class=\"viewer-container\" id=\"viewer-container\">\n      <div id=\"loading-msg\" class=\"loading\">\n        <div class=\"spinner\"></div>\n        <span>Preparando documento interactivo...</span>\n      </div>\n\n      <div class=\"page-wrapper\" id=\"page-wrapper\">\n        <canvas id=\"pdf-canvas\"></canvas>\n        <canvas id=\"draw-canvas\"></canvas>\n      </div>\n    </main>\n  </div>\n\n  <div class=\"toast\" id=\"toast\"></div>\n\n  <!-- Contenido Base64 inyectado -->\n  <script id=\"raw-data\" type=\"text/plain\">{{FILE_DATA_URL}}</script>\n\n  <script>\n    let pdfDoc = null;\n    let pageNum = 1;\n    let pageRendering = false;\n    let pageNumPending = null;\n    let scale = 1.25;\n    let rotation = 0;\n    let nightMode = false;\n    let highlighterActive = false;\n    let isDrawing = false;\n    let pageTextCache = [];\n    let searchMatches = [];\n    let currentMatchIdx = -1;\n\n    const canvas = document.getElementById('pdf-canvas');\n    const ctx = canvas.getContext('2d');\n    const drawCanvas = document.getElementById('draw-canvas');\n    const drawCtx = drawCanvas.getContext('2d');\n    const pageWrapper = document.getElementById('page-wrapper');\n    const loadingMsg = document.getElementById('loading-msg');\n\n    function showToast(msg) {\n      const t = document.getElementById('toast');\n      t.textContent = msg;\n      t.classList.add('show');\n      clearTimeout(t._timer);\n      t._timer = setTimeout(() => t.classList.remove('show'), 2200);\n    }\n\n    function initPdfViewer() {\n      if (typeof pdfjsLib === 'undefined') {\n        loadingMsg.innerHTML = '<span style=\"color:#f43f5e;\">Error de red al cargar el visor PDF.</span>';\n        return;\n      }\n\n      const raw = document.getElementById('raw-data').textContent.trim();\n      if (!raw) {\n        loadingMsg.innerHTML = '<span style=\"color:#f43f5e;\">El documento PDF está vacío.</span>';\n        return;\n      }\n\n      try {\n        const base64 = raw.includes(',') ? raw.split(',')[1].replace(/\\s/g, '') : raw.replace(/\\s/g, '');\n        const binaryString = atob(base64);\n        const bytes = new Uint8Array(binaryString.length);\n        for (let i = 0; i < binaryString.length; i++) {\n          bytes[i] = binaryString.charCodeAt(i);\n        }\n\n        pdfjsLib.getDocument({ data: bytes, disableWorker: true }).promise.then(async function(pdf) {\n          pdfDoc = pdf;\n          loadingMsg.style.display = 'none';\n          pageWrapper.style.display = 'block';\n          document.getElementById('page-count').textContent = pdf.numPages;\n          document.getElementById('page-input').max = pdf.numPages;\n\n          renderPage(pageNum);\n          buildThumbnails();\n          extractAllText();\n        }).catch(err => {\n          loadingMsg.innerHTML = `<span style=\"color:#f43f5e;\">Error al abrir el PDF: ${err.message}</span>`;\n        });\n      } catch (err) {\n        loadingMsg.innerHTML = `<span style=\"color:#f43f5e;\">Archivo inválido: ${err.message}</span>`;\n      }\n    }\n\n    function renderPage(num) {\n      pageRendering = true;\n      pdfDoc.getPage(num).then(function(page) {\n        const viewport = page.getViewport({ scale: scale, rotation: rotation });\n        canvas.height = viewport.height;\n        canvas.width = viewport.width;\n        drawCanvas.height = viewport.height;\n        drawCanvas.width = viewport.width;\n\n        page.render({ canvasContext: ctx, viewport: viewport }).promise.then(function() {\n          pageRendering = false;\n          if (pageNumPending !== null) {\n            renderPage(pageNumPending);\n            pageNumPending = null;\n          }\n        });\n      });\n\n      document.getElementById('page-input').value = num;\n      document.getElementById('prev-page').disabled = (num <= 1);\n      document.getElementById('next-page').disabled = (num >= pdfDoc.numPages);\n      document.getElementById('zoom-label').textContent = Math.round(scale * 100) + '%';\n\n      // Barra de progreso\n      const pct = (num / pdfDoc.numPages) * 100;\n      document.getElementById('progress-fill').style.width = pct + '%';\n\n      // Resaltar miniatura activa\n      document.querySelectorAll('.thumb-card').forEach((el, idx) => {\n        el.classList.toggle('active', idx + 1 === num);\n      });\n    }\n\n    function queueRenderPage(num) {\n      if (pageRendering) pageNumPending = num;\n      else renderPage(num);\n    }\n\n    function onPrevPage() { if (pageNum > 1) { pageNum--; queueRenderPage(pageNum); } }\n    function onNextPage() { if (pdfDoc && pageNum < pdfDoc.numPages) { pageNum++; queueRenderPage(pageNum); } }\n\n    function jumpToPage(val) {\n      if (!pdfDoc) return;\n      let target = parseInt(val, 10);\n      if (isNaN(target)) return;\n      target = Math.max(1, Math.min(pdfDoc.numPages, target));\n      pageNum = target;\n      queueRenderPage(pageNum);\n    }\n\n    function zoomIn() { if (pdfDoc) { scale = Math.min(3.0, +(scale + 0.2).toFixed(2)); queueRenderPage(pageNum); } }\n    function zoomOut() { if (pdfDoc) { scale = Math.max(0.5, +(scale - 0.2).toFixed(2)); queueRenderPage(pageNum); } }\n\n    function fitWidth() {\n      if (!pdfDoc) return;\n      pdfDoc.getPage(pageNum).then(page => {\n        const containerWidth = document.getElementById('viewer-container').clientWidth - 70;\n        const unscaledViewport = page.getViewport({ scale: 1, rotation: rotation });\n        scale = Math.max(0.5, Math.min(2.5, +(containerWidth / unscaledViewport.width).toFixed(2)));\n        queueRenderPage(pageNum);\n        showToast('Ajustado al ancho de pantalla');\n      });\n    }\n\n    function rotateDoc() {\n      if (!pdfDoc) return;\n      rotation = (rotation + 90) % 360;\n      queueRenderPage(pageNum);\n    }\n\n    // Miniaturas laterales\n    async function buildThumbnails() {\n      const sidebar = document.getElementById('sidebar');\n      sidebar.innerHTML = '';\n      const maxThumbs = Math.min(pdfDoc.numPages, 40); // Límite fluido\n      for (let i = 1; i <= maxThumbs; i++) {\n        const card = document.createElement('div');\n        card.className = 'thumb-card' + (i === 1 ? ' active' : '');\n        card.onclick = () => { pageNum = i; queueRenderPage(i); };\n\n        const thumbCanvas = document.createElement('canvas');\n        const label = document.createElement('div');\n        label.className = 'thumb-label';\n        label.textContent = `Página ${i}`;\n\n        card.appendChild(thumbCanvas);\n        card.appendChild(label);\n        sidebar.appendChild(card);\n\n        const page = await pdfDoc.getPage(i);\n        const vp = page.getViewport({ scale: 0.24 });\n        thumbCanvas.width = vp.width;\n        thumbCanvas.height = vp.height;\n        await page.render({ canvasContext: thumbCanvas.getContext('2d'), viewport: vp }).promise;\n      }\n    }\n\n    function toggleSidebar() {\n      document.getElementById('sidebar').classList.toggle('collapsed');\n    }\n\n    // Modo Noche\n    function toggleNightMode() {\n      nightMode = !nightMode;\n      pageWrapper.classList.toggle('night-mode', nightMode);\n      document.getElementById('night-btn').classList.toggle('active', nightMode);\n      showToast(nightMode ? 'Modo lectura nocturna activado' : 'Modo claro activado');\n    }\n\n    // Subrayador temporal de estudio\n    function toggleHighlighter() {\n      highlighterActive = !highlighterActive;\n      drawCanvas.classList.toggle('drawing-active', highlighterActive);\n      document.getElementById('pen-btn').classList.toggle('active', highlighterActive);\n      document.getElementById('clear-pen-btn').style.display = highlighterActive ? 'inline-flex' : 'none';\n      showToast(highlighterActive ? 'Subrayador activo: dibuja sobre el texto' : 'Subrayador desactivado');\n    }\n\n    function clearHighlights() {\n      drawCtx.clearRect(0, 0, drawCanvas.width, drawCanvas.height);\n      showToast('Anotaciones borradas');\n    }\n\n    drawCanvas.addEventListener('pointerdown', (e) => {\n      if (!highlighterActive) return;\n      isDrawing = true;\n      const rect = drawCanvas.getBoundingClientRect();\n      drawCtx.beginPath();\n      drawCtx.moveTo(e.clientX - rect.left, e.clientY - rect.top);\n    });\n\n    drawCanvas.addEventListener('pointermove', (e) => {\n      if (!isDrawing || !highlighterActive) return;\n      const rect = drawCanvas.getBoundingClientRect();\n      drawCtx.strokeStyle = 'rgba(250, 204, 21, 0.35)';\n      drawCtx.lineWidth = 16;\n      drawCtx.lineCap = 'round';\n      drawCtx.lineTo(e.clientX - rect.left, e.clientY - rect.top);\n      drawCtx.stroke();\n    });\n\n    window.addEventListener('pointerup', () => { isDrawing = false; });\n\n    // Buscador de texto en todo el PDF\n    async function extractAllText() {\n      pageTextCache = [];\n      for (let i = 1; i <= pdfDoc.numPages; i++) {\n        const page = await pdfDoc.getPage(i);\n        const content = await page.getTextContent();\n        const text = content.items.map(item => item.str).join(' ');\n        pageTextCache.push({ page: i, text: text.toLowerCase() });\n      }\n    }\n\n    function toggleSearch() {\n      const bar = document.getElementById('search-bar');\n      bar.classList.toggle('open');\n      if (bar.classList.contains('open')) {\n        document.getElementById('search-input').focus();\n      }\n    }\n\n    function runSearch() {\n      const q = document.getElementById('search-input').value.trim().toLowerCase();\n      const status = document.getElementById('search-status');\n      if (!q) return;\n\n      searchMatches = pageTextCache.filter(p => p.text.includes(q)).map(p => p.page);\n      if (searchMatches.length === 0) {\n        status.textContent = 'Sin coincidencias';\n        document.getElementById('prev-match-btn').disabled = true;\n        document.getElementById('next-match-btn').disabled = true;\n        return;\n      }\n\n      currentMatchIdx = 0;\n      document.getElementById('prev-match-btn').disabled = false;\n      document.getElementById('next-match-btn').disabled = false;\n      goToMatch();\n    }\n\n    function goToMatch() {\n      const targetPage = searchMatches[currentMatchIdx];\n      document.getElementById('search-status').textContent = `Coincidencia ${currentMatchIdx + 1} de ${searchMatches.length} (Pág. ${targetPage})`;\n      pageNum = targetPage;\n      queueRenderPage(pageNum);\n    }\n\n    function nextMatch() {\n      if (!searchMatches.length) return;\n      currentMatchIdx = (currentMatchIdx + 1) % searchMatches.length;\n      goToMatch();\n    }\n\n    function prevMatch() {\n      if (!searchMatches.length) return;\n      currentMatchIdx = (currentMatchIdx - 1 + searchMatches.length) % searchMatches.length;\n      goToMatch();\n    }\n\n    // Pantalla completa\n    function toggleFullscreen() {\n      if (!document.fullscreenElement) {\n        document.documentElement.requestFullscreen().catch(() => {});\n      } else {\n        document.exitFullscreen().catch(() => {});\n      }\n    }\n\n    // Atajos de teclado\n    document.addEventListener('keydown', (e) => {\n      if (e.target.tagName === 'INPUT') return;\n      if (e.key === 'ArrowRight') onNextPage();\n      else if (e.key === 'ArrowLeft') onPrevPage();\n      else if (e.key === '+' || e.key === '=') zoomIn();\n      else if (e.key === '-') zoomOut();\n      else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'f') {\n        e.preventDefault();\n        toggleSearch();\n      }\n    });\n\n    initPdfViewer();\n  </script>\n</body>\n</html>"
  },
