    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>{{FILE_NAME}}</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: system-ui, -apple-system, sans-serif;\n      background: #0b1120;\n      color: #f8fafc;\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n      user-select: none;\n    }\n    .toolbar {\n      background: #111827;\n      padding: 10px 16px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid #334155;\n      gap: 10px;\n      z-index: 10;\n      flex-shrink: 0;\n    }\n    .file-name {\n      font-size: 13px; \n      font-weight: 600; \n      overflow: hidden;\n      text-overflow: ellipsis; \n      white-space: nowrap; \n      max-width: 45%; \n      color: #e2e8f0;\n    }\n    .controls { display: flex; align-items: center; gap: 6px; }\n    button {\n      background: #1e293b; color: #f8fafc; border: 1px solid #334155;\n      padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;\n    }\n    button:hover { background: #334155; }\n    \n    /* Contenedor con scroll habilitado para subir y bajar */\n    .canvas-container {\n      flex: 1;\n      overflow: auto; /* Permite scroll vertical y horizontal sin bloqueos */\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 40px;\n      background-image: radial-gradient(#1e293b 1.2px, transparent 1.2px);\n      background-size: 22px 22px;\n      position: relative;\n    }\n    \n    .img-wrapper {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      min-width: 100%;\n      min-height: 100%;\n    }\n\n    img {\n      max-width: 90vw;\n      max-height: 85vh;\n      object-fit: contain;\n      transform-origin: center center;\n      transition: transform 0.1s ease;\n      box-shadow: 0 15px 35px rgba(0,0,0,0.5);\n      border-radius: 4px;\n      pointer-events: none;\n    }\n  </style>\n</head>\n<body oncontextmenu=\"return false;\">\n  <div class=\"toolbar\">\n    <span class=\"file-name\">🖼️ {{FILE_NAME}}</span>\n    <div class=\"controls\">\n      <button onclick=\"zoom(-0.25)\">➖</button>\n      <button onclick=\"resetView()\">100%</button>\n      <button onclick=\"zoom(0.25)\">➕</button>\n      <button onclick=\"rotateImg()\">↻ Rotar</button>\n      <button onclick=\"toggleFS()\">⛶</button>\n    </div>\n  </div>\n\n  <div class=\"canvas-container\" id=\"container\">\n    <div class=\"img-wrapper\">\n      <img id=\"preview-img\" alt=\"{{FILE_NAME}}\" draggable=\"false\">\n    </div>\n  </div>\n\n  <script id=\"raw-data\" type=\"text/plain\">{{FILE_DATA_URL}}</script>\n\n  <script>\n    let scale = 1, rotation = 0;\n    const img = document.getElementById('preview-img');\n    const dataUrl = document.getElementById('raw-data').textContent.trim();\n    \n    if (dataUrl) img.src = dataUrl;\n\n    function update() {\n      img.style.transform = `scale(${scale}) rotate(${rotation}deg)`;\n    }\n    \n    function zoom(d) {\n      scale = Math.max(0.3, Math.min(5, scale + d));\n      update();\n    }\n    \n    function rotateImg() {\n      rotation = (rotation + 90) % 360;\n      update();\n    }\n    \n    function resetView() {\n      scale = 1;\n      rotation = 0;\n      update();\n    }\n    \n    function toggleFS() {\n      if (!document.fullscreenElement) document.documentElement.requestFullscreen();\n      else document.exitFullscreen();\n    }\n  </script>\n</body>\n</html>"
