[
  {
    "id": 501,
    "ext": "pdf",
    "name": "Visor PDF Protegido (Sin descarga)",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>{{FILE_NAME}}</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    html, body {\n      height: 100%;\n      width: 100%;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Inter, sans-serif;\n      background-color: #f1f5f9;\n      color: #0f172a;\n      user-select: none;\n      -webkit-user-select: none;\n    }\n\n    .viewer-wrapper {\n      display: flex;\n      flex-direction: column;\n      height: 100vh;\n      width: 100vw;\n    }\n\n    .topbar {\n      height: 52px;\n      padding: 0 20px;\n      background-color: #ffffff;\n      border-bottom: 1px solid #e2e8f0;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 12px;\n      flex-shrink: 0;\n    }\n\n    .doc-info {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      min-width: 0;\n    }\n\n    .badge-pdf {\n      background-color: #eff6ff;\n      color: #0f6cbf;\n      border: 1px solid #bfdbfe;\n      font-size: 11px;\n      font-weight: 700;\n      padding: 3px 8px;\n      border-radius: 6px;\n      letter-spacing: 0.04em;\n      flex-shrink: 0;\n    }\n\n    .doc-title {\n      font-size: 14px;\n      font-weight: 600;\n      color: #1e293b;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .readonly-pill {\n      font-size: 11px;\n      font-weight: 600;\n      color: #64748b;\n      background-color: #f8fafc;\n      border: 1px solid #e2e8f0;\n      padding: 4px 10px;\n      border-radius: 999px;\n      flex-shrink: 0;\n    }\n\n    .pdf-stage {\n      flex: 1;\n      padding: 16px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      background-color: #f1f5f9;\n      overflow: hidden;\n    }\n\n    .pdf-frame-card {\n      width: 100%;\n      max-width: 1050px;\n      height: 100%;\n      background: #ffffff;\n      border-radius: 12px;\n      border: 1px solid #cbd5e1;\n      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);\n      overflow: hidden;\n    }\n\n    iframe {\n      width: 100%;\n      height: 100%;\n      border: 0;\n      display: block;\n    }\n\n    @media (max-width: 640px) {\n      .pdf-stage {\n        padding: 0;\n      }\n      .pdf-frame-card {\n        border-radius: 0;\n        border: 0;\n      }\n      .readonly-pill {\n        display: none;\n      }\n    }\n  </style>\n</head>\n<body oncontextmenu=\"return false;\">\n  <div class=\"viewer-wrapper\">\n    <header class=\"topbar\">\n      <div class=\"doc-info\">\n        <span class=\"badge-pdf\">PDF</span>\n        <span class=\"doc-title\" title=\"{{FILE_NAME}}\">{{FILE_NAME}}</span>\n      </div>\n      <span class=\"readonly-pill\">Solo lectura</span>\n    </header>\n\n    <main class=\"pdf-stage\">\n      <div class=\"pdf-frame-card\">\n        <iframe\n          src=\"{{FILE_DATA_URL}}#toolbar=0&navpanes=0&scrollbar=1&view=FitH\"\n          title=\"{{FILE_NAME}}\">\n        </iframe>\n      </div>\n    </main>\n  </div>\n\n  <script>\n    // Bloquea atajos comunes de guardar o imprimir\n    document.addEventListener('keydown', function (e) {\n      if ((e.ctrlKey || e.metaKey) && ['s', 'p', 'u'].includes(e.key.toLowerCase())) {\n        e.preventDefault();\n      }\n    });\n  </script>\n</body>\n</html>"
  },
  {
    "id": 502,
    "ext": "png",
    "name": "Visor de Imagen Protegida",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head><meta charset=\"UTF-8\"><style>body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0f172a;user-select:none;}img{max-width:95vw;max-height:95vh;pointer-events:none;border-radius:8px;box-shadow:0 10px 25px rgba(0,0,0,.5);}</style></head>\n<body oncontextmenu=\"return false;\">\n  <img src=\"{{FILE_DATA_URL}}\" alt=\"{{FILE_NAME}}\">\n</body>\n</html>"
  }
]