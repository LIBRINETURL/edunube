[
  {
    "id": 501,
    "ext": "pdf",
    "name": "Visor PDF Protegido (Sin descarga)",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>{{FILE_NAME}}</title>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    html, body {\n      height: 100%;\n      width: 100%;\n      background: #0f172a;\n      color: #f8fafc;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Inter, sans-serif;\n      user-select: none;\n      -webkit-user-select: none;\n      overflow: hidden;\n    }\n\n    .app {\n      display: flex;\n      flex-direction: column;\n      height: 100vh;\n      width: 100vw;\n    }\n\n    .toolbar {\n      height: 54px;\n      padding: 0 16px;\n      background: #1e293b;\n      border-bottom: 1px solid #334155;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 12px;\n      flex-shrink: 0;\n    }\n\n    .doc-title {\n      font-size: 13px;\n      font-weight: 600;\n      color: #e2e8f0;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      max-width: 240px;\n    }\n\n    .controls {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      flex-wrap: wrap;\n    }\n\n    .btn {\n      background: #334155;\n      color: #f8fafc;\n      border: 1px solid #475569;\n      border-radius: 8px;\n      padding: 6px 11px;\n      font-size: 12px;\n      font-weight: 600;\n      cursor: pointer;\n      transition: background 0.15s ease;\n    }\n\n    .btn:hover:not(:disabled) {\n      background: #475569;\n    }\n\n    .btn:disabled {\n      opacity: 0.4;\n      cursor: not-allowed;\n    }\n\n    .page-indicator {\n      font-size: 12px;\n      font-weight: 600;\n      min-width: 78px;\n      text-align: center;\n      color: #cbd5e1;\n    }\n\n    .zoom-indicator {\n      font-size: 12px;\n      font-weight: 600;\n      min-width: 48px;\n      text-align: center;\n      color: #cbd5e1;\n    }\n\n    .stage {\n      flex: 1;\n      overflow: auto;\n      display: flex;\n      justify-content: center;\n      align-items: flex-start;\n      padding: 20px 14px;\n      background: #0f172a;\n    }\n\n    canvas {\n      background: #ffffff;\n      border-radius: 6px;\n      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);\n      max-width: 100%;\n      height: auto;\n    }\n\n    .status {\n      margin-top: 40px;\n      font-size: 13px;\n      color: #94a3b8;\n    }\n  </style>\n</head>\n<body oncontextmenu=\"return false;\">\n  <div class=\"app\">\n    <header class=\"toolbar\">\n      <div class=\"doc-title\" title=\"{{FILE_NAME}}\">{{FILE_NAME}}</div>\n\n      <div class=\"controls\">\n        <button id=\"prev-page\" class=\"btn\" type=\"button\" disabled>← Anterior</button>\n        <span id=\"page-info\" class=\"page-indicator\">- / -</span>\n        <button id=\"next-page\" class=\"btn\" type=\"button\" disabled>Siguiente →</button>\n\n        <button id=\"zoom-out\" class=\"btn\" type=\"button\" title=\"Alejar\">−</button>\n        <span id=\"zoom-info\" class=\"zoom-indicator\">100%</span>\n        <button id=\"zoom-in\" class=\"btn\" type=\"button\" title=\"Acercar\">+</button>\n      </div>\n    </header>\n\n    <main id=\"stage\" class=\"stage\">\n      <div id=\"status\" class=\"status\">Cargando documento PDF...</div>\n      <canvas id=\"pdf-canvas\" style=\"display: none;\"></canvas>\n    </main>\n  </div>\n\n  <script>\n    const FILE_DATA_URL = \"{{FILE_DATA_URL}}\";\n\n    const pdfjsLib = window['pdfjs-dist/build/pdf'];\n    if (pdfjsLib && pdfjsLib.GlobalWorkerOptions) {\n      pdfjsLib.GlobalWorkerOptions.workerSrc =\n        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';\n    }\n\n    let pdfDoc = null;\n    let currentPage = 1;\n    let scale = 1.25;\n    let isRendering = false;\n    let pendingPage = null;\n\n    const canvas = document.getElementById('pdf-canvas');\n    const ctx = canvas.getContext('2d');\n    const statusEl = document.getElementById('status');\n    const pageInfoEl = document.getElementById('page-info');\n    const zoomInfoEl = document.getElementById('zoom-info');\n    const prevBtn = document.getElementById('prev-page');\n    const nextBtn = document.getElementById('next-page');\n    const zoomInBtn = document.getElementById('zoom-in');\n    const zoomOutBtn = document.getElementById('zoom-out');\n\n    function dataUrlToUint8Array(dataUrl) {\n      const parts = dataUrl.split(',');\n      if (parts.length < 2) return null;\n      const binary = atob(parts[1].replace(/\\s/g, ''));\n      const len = binary.length;\n      const bytes = new Uint8Array(len);\n      for (let i = 0; i < len; i++) {\n        bytes[i] = binary.charCodeAt(i);\n      }\n      return bytes;\n    }\n\n    function updateControls() {\n      const total = pdfDoc ? pdfDoc.numPages : 0;\n      pageInfoEl.textContent = total ? `${currentPage} / ${total}` : '- / -';\n      zoomInfoEl.textContent = `${Math.round(scale * 100)}%`;\n      prevBtn.disabled = !pdfDoc || currentPage <= 1;\n      nextBtn.disabled = !pdfDoc || currentPage >= total;\n    }\n\n    async function renderPage(num) {\n      if (!pdfDoc) return;\n      if (isRendering) {\n        pendingPage = num;\n        return;\n      }\n      isRendering = true;\n\n      try {\n        const page = await pdfDoc.getPage(num);\n        const viewport = page.getViewport({ scale });\n        canvas.height = viewport.height;\n        canvas.width = viewport.width;\n\n        await page.render({\n          canvasContext: ctx,\n          viewport\n        }).promise;\n\n        currentPage = num;\n        statusEl.style.display = 'none';\n        canvas.style.display = 'block';\n        updateControls();\n      } catch (err) {\n        statusEl.style.display = 'block';\n        canvas.style.display = 'none';\n        statusEl.textContent = 'No se pudo renderizar la página del PDF.';\n      } finally {\n        isRendering = false;\n        if (pendingPage !== null) {\n          const next = pendingPage;\n          pendingPage = null;\n          renderPage(next);\n        }\n      }\n    }\n\n    prevBtn.addEventListener('click', () => {\n      if (currentPage > 1) renderPage(currentPage - 1);\n    });\n\n    nextBtn.addEventListener('click', () => {\n      if (pdfDoc && currentPage < pdfDoc.numPages) renderPage(currentPage + 1);\n    });\n\n    zoomInBtn.addEventListener('click', () => {\n      scale = Math.min(2.5, +(scale + 0.25).toFixed(2));\n      renderPage(currentPage);\n    });\n\n    zoomOutBtn.addEventListener('click', () => {\n      scale = Math.max(0.5, +(scale - 0.25).toFixed(2));\n      renderPage(currentPage);\n    });\n\n    document.addEventListener('keydown', (e) => {\n      if ((e.ctrlKey || e.metaKey) && ['s', 'p', 'u'].includes(e.key.toLowerCase())) {\n        e.preventDefault();\n      }\n      if (e.key === 'ArrowLeft' && currentPage > 1) renderPage(currentPage - 1);\n      if (e.key === 'ArrowRight' && pdfDoc && currentPage < pdfDoc.numPages) renderPage(currentPage + 1);\n    });\n\n    async function initPdf() {\n      try {\n        const bytes = dataUrlToUint8Array(FILE_DATA_URL);\n        if (!bytes || bytes.length === 0) {\n          statusEl.textContent = 'Archivo PDF vacío o no válido.';\n          return;\n        }\n        const loadingTask = pdfjsLib.getDocument({ data: bytes });\n        pdfDoc = await loadingTask.promise;\n        await renderPage(1);\n      } catch (err) {\n        statusEl.textContent = 'Error al abrir el PDF con el visor Canvas.';\n      }\n    }\n\n    initPdf();\n  </script>\n</body>\n</html>"
  },
  {
    "id": 502,
    "ext": "png",
    "name": "Visor de Imagen Protegida",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head><meta charset=\"UTF-8\"><style>body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0f172a;user-select:none;}img{max-width:95vw;max-height:95vh;pointer-events:none;border-radius:8px;box-shadow:0 10px 25px rgba(0,0,0,.5);}</style></head>\n<body oncontextmenu=\"return false;\">\n  <img src=\"{{FILE_DATA_URL}}\" alt=\"{{FILE_NAME}}\">\n</body>\n</html>"
  }
