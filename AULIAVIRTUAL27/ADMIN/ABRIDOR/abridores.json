    "id": 501,
    "ext": "pdf",
    "name": "Visor PDF Protegido (Sin descarga)",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>{{FILE_NAME}}</title>\n  <!-- Importar PDF.js desde CDN -->\n  <script src=\"https://cloudflare.com\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n      user-select: none; /* Evita seleccionar texto o elementos */\n    }\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      background-color: #2b2b2b;\n      color: #ffffff;\n      display: flex;\n      flex-direction: column;\n      height: 100vh;\n      overflow: hidden;\n    }\n    header {\n      background-color: #1e1e1e;\n      padding: 12px 20px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 1px solid #3d3d3d;\n      z-index: 10;\n    }\n    .doc-title {\n      font-size: 15px;\n      font-weight: 500;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      max-width: 45%;\n    }\n    .controls {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n    button {\n      background-color: #3a3a3a;\n      color: #ffffff;\n      border: 1px solid #555;\n      padding: 6px 12px;\n      border-radius: 4px;\n      cursor: pointer;\n      font-size: 13px;\n      transition: background 0.2s;\n    }\n    button:hover:not(:disabled) {\n      background-color: #505050;\n    }\n    button:disabled {\n      opacity: 0.4;\n      cursor: not-allowed;\n    }\n    .page-info {\n      font-size: 13px;\n      min-width: 85px;\n      text-align: center;\n    }\n    #viewer-container {\n      flex: 1;\n      overflow: auto;\n      display: flex;\n      justify-content: center;\n      align-items: flex-start;\n      padding: 24px;\n    }\n    canvas {\n      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);\n      background-color: #ffffff;\n      max-width: none;\n    }\n    #loading {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      font-size: 16px;\n      color: #cccccc;\n    }\n  </style>\n</head>\n<!-- Bloquea el clic derecho en toda la página -->\n<body oncontextmenu=\"return false;\">\n\n  <header>\n    <div class=\"doc-title\" title=\"{{FILE_NAME}}\">{{FILE_NAME}}</div>\n    <div class=\"controls\">\n      <button id=\"prev-page\" disabled>Anterior</button>\n      <span class=\"page-info\">Pág. <span id=\"page-num\">0</span> / <span id=\"page-count\">0</span></span>\n      <button id=\"next-page\" disabled>Siguiente</button>\n      <button id=\"zoom-out\">-</button>\n      <button id=\"zoom-in\">+</button>\n    </div>\n  </header>\n\n  <div id=\"viewer-container\">\n    <div id=\"loading\">Cargando documento...</div>\n    <canvas id=\"pdf-render\" style=\"display: none;\"></canvas>\n  </div>\n\n  <script>\n    // Inyección de variables de plantilla\n    const fileDataUrl = \"{{FILE_DATA_URL}}\";\n    const fileName = \"{{FILE_NAME}}\";\n\n    // Configurar el worker de PDF.js\n    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cloudflare.com';\n\n    let pdfDoc = null,\n        pageNum = 1,\n        pageIsRendering = false,\n        pageNumIsPending = null,\n        scale = 1.3;\n\n    const canvas = document.getElementById('pdf-render'),\n          ctx = canvas.getContext('2d'),\n          loadingEl = document.getElementById('loading');\n\n    // Renderizar una página específica\n    const renderPage = num => {\n      pageIsRendering = true;\n\n      pdfDoc.getPage(num).then(page => {\n        const viewport = page.getViewport({ scale });\n        canvas.height = viewport.height;\n        canvas.width = viewport.width;\n\n        const renderCtx = {\n          canvasContext: ctx,\n          viewport: viewport\n        };\n\n        page.render(renderCtx).promise.then(() => {\n          pageIsRendering = false;\n          if (pageNumIsPending !== null) {\n            renderPage(pageNumIsPending);\n            pageNumIsPending = null;\n          }\n        });\n\n        document.getElementById('page-num').textContent = num;\n        updateButtons();\n      });\n    };\n\n    // Encolar renderizado si ya hay uno en proceso\n    const queueRenderPage = num => {\n      if (pageIsRendering) {\n        pageNumIsPending = num;\n      } else {\n        renderPage(num);\n      }\n    };\n\n    // Actualizar estado de los botones de navegación\n    const updateButtons = () => {\n      document.getElementById('prev-page').disabled = (pageNum <= 1);\n      document.getElementById('next-page').disabled = (pageNum >= pdfDoc.numPages);\n    };\n\n    // Cargar el documento desde el Data URL\n    pdfjsLib.getDocument(fileDataUrl).promise.then(pdfDoc_ => {\n      pdfDoc = pdfDoc_;\n      document.getElementById('page-count').textContent = pdfDoc.numPages;\n      loadingEl.style.display = 'none';\n      canvas.style.display = 'block';\n      renderPage(pageNum);\n    }).catch(err => {\n      loadingEl.textContent = 'Error al cargar el archivo PDF.';\n      console.error(err);\n    });\n\n    // Eventos de controles\n    document.getElementById('prev-page').addEventListener('click', () => {\n      if (pageNum <= 1) return;\n      pageNum--;\n      queueRenderPage(pageNum);\n    });\n\n    document.getElementById('next-page').addEventListener('click', () => {\n      if (pageNum >= pdfDoc.numPages) return;\n      pageNum++;\n      queueRenderPage(pageNum);\n    });\n\n    document.getElementById('zoom-in').addEventListener('click', () => {\n      if (scale >= 3.0) return;\n      scale += 0.25;\n      queueRenderPage(pageNum);\n    });\n\n    document.getElementById('zoom-out').addEventListener('click', () => {\n      if (scale <= 0.5) return;\n      scale -= 0.25;\n      queueRenderPage(pageNum);\n    });\n\n    // Bloquear atajos de teclado comunes para guardar o imprimir (Ctrl+S, Ctrl+P)\n    document.addEventListener('keydown', e => {\n      if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 's' || e.key.toLowerCase() === 'p')) {\n        e.preventDefault();\n      }\n    });\n  </script>\n</body>\n</html>\n"
  },
