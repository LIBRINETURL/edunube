    "ext": "png",
    "name": "Visor de Imagen Protegida",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>{{FILE_NAME}}</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n      user-select: none; /* Evita selección de texto/imagen */\n      -webkit-user-select: none;\n    }\n\n    body {\n      background-color: #121212;\n      color: #f1f1f1;\n      font-family: system-ui, -apple-system, sans-serif;\n      display: flex;\n      flex-direction: column;\n      height: 100vh;\n      overflow: hidden;\n    }\n\n    /* Barra superior */\n    header {\n      background-color: #1e1e1e;\n      padding: 12px 20px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 1px solid #333;\n      z-index: 10;\n    }\n\n    .file-title {\n      font-size: 15px;\n      font-weight: 500;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      max-width: 60%;\n    }\n\n    /* Controles de zoom */\n    .controls {\n      display: flex;\n      gap: 8px;\n    }\n\n    button {\n      background-color: #2d2d2d;\n      color: #fff;\n      border: 1px solid #444;\n      padding: 6px 12px;\n      border-radius: 6px;\n      cursor: pointer;\n      font-size: 14px;\n      transition: background 0.2s;\n    }\n\n    button:hover {\n      background-color: #3d3d3d;\n    }\n\n    /* Área de visualización */\n    .viewer-container {\n      flex: 1;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      overflow: auto;\n      position: relative;\n      padding: 20px;\n    }\n\n    /* Capa transparente para bloquear arrastre e interacción directa con la imagen */\n    .shield {\n      position: relative;\n      display: inline-block;\n    }\n\n    .shield::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background: transparent;\n      z-index: 5;\n    }\n\n    img {\n      max-width: 100%;\n      max-height: 82vh;\n      object-fit: contain;\n      transition: transform 0.2s ease;\n      pointer-events: none; /* Impide arrastrar la imagen */\n      border-radius: 4px;\n      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);\n    }\n  </style>\n</head>\n<body oncontextmenu=\"return false;\"> <!-- Bloquea menú contextual (clic derecho) -->\n\n  <header>\n    <div class=\"file-title\" title=\"{{FILE_NAME}}\">{{FILE_NAME}}</div>\n    <div class=\"controls\">\n      <button onclick=\"cambiarZoom(-0.2)\">➖ Alejar</button>\n      <button onclick=\"resetZoom()\">100%</button>\n      <button onclick=\"cambiarZoom(0.2)\">➕ Acercar</button>\n    </div>\n  </header>\n\n  <main class=\"viewer-container\">\n    <div class=\"shield\">\n      <img id=\"imagenVisor\" src=\"{{FILE_DATA_URL}}\" alt=\"{{FILE_NAME}}\" draggable=\"false\">\n    </div>\n  </main>\n\n  <script>\n    let escala = 1;\n    const img = document.getElementById('imagenVisor');\n\n    function cambiarZoom(delta) {\n      escala = Math.min(Math.max(0.4, escala + delta), 3); // Límite entre 40% y 300%\n      img.style.transform = `scale(${escala})`;\n    }\n\n    function resetZoom() {\n      escala = 1;\n      img.style.transform = 'scale(1)';\n    }\n\n    // Bloquea atajos comunes de guardado (Ctrl+S / Cmd+S)\n    document.addEventListener('keydown', function(e) {\n      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {\n        e.preventDefault();\n      }\n    });\n  </script>\n\n</body>\n</html>\n"
  }
