    "name": "Visor de Imagen Protegida",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head><meta charset=\"UTF-8\"><style>body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0f172a;user-select:none;}img{max-width:95vw;max-height:95vh;pointer-events:none;border-radius:8px;box-shadow:0 10px 25px rgba(0,0,0,.5);}</style></head>\n<body oncontextmenu=\"return false;\">\n  <img src=\"{{FILE_DATA_URL}}\" alt=\"{{FILE_NAME}}\">\n</body>\n</html>"
