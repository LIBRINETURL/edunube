    "id": 501,
    "ext": "pdf",
    "name": "Visor PDF Protegido (Sin descarga)",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>{{FILE_NAME}}</title>\n  <!-- Cargamos PDF.js desde CDN -->\n  <script src=\"https://cloudflare.com\"></script>\n  <style>\n    :root {\n      --bg-dark: #0f172a;\n      --toolbar-bg: #1e293b;\n      --text-color: #f8fafc;\n      --accent: #3b82f6;\n      --accent-hover: #2563eb;\n      --border: #334155;\n    }\n\n    * {\n      box-sizing: border-box;\n      user-select: none;\n      -webkit-user-select: none;\n    }\n\n    body, html {\n      margin: 0;\n      padding: 0;\n      height: 100%;\n      background-color: var(--bg-dark);\n      color: var(--text-color);\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n    }\n\n    /* Barra superior */\n    .toolbar {\n      height: 56px;\n      background-color: var(--toolbar-bg);\n      border-bottom: 1px solid var(--border);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 20px;\n      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);\n      z-index: 10;\n    }\n\n    .file-info {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-weight: 500;\n      font-size: 0.95rem;\n      max-width: 40%;\n    }\n\n    .file-name {\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .badge {\n      background: rgba(59, 130, 246, 0.2);\n      color: #60a5fa;\n      padding: 2px 8px;\n      border-radius: 4px;\n      font-size: 0.75rem;\n      font-weight: 600;\n      border: 1px solid rgba(59, 130, 246, 0.3);\n    }\n\n    .controls {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    button {\n      background: #334155;\n      color: var(--text-color);\n      border: 1px solid #475569;\n      border-radius: 6px;\n      padding: 6px 12px;\n      cursor: pointer;\n      font-size: 0.85rem;\n      display: flex;\n      align-items: center;\n      gap: 5px;\n      transition: all 0.2s;\n    }\n\n    button:hover:not(:disabled) {\n      background: var(--accent);\n      border-color: var(--accent);\n    }\n\n    button:disabled {\n      opacity: 0.4;\n      cursor: not-allowed;\n    }\n\n    .page-indicator, .zoom-indicator {\n      font-size: 0.85rem;\n      padding: 0 8px;\n      color: #cbd5e1;\n      min-width: 75px;\n      text-align: center;\n    }\n\n    /* Contenedor del PDF */\n    #viewer-container {\n      flex: 1;\n      overflow-y: auto;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      padding: 24px;\n      gap: 20px;\n      scroll-behavior: smooth;\n    }\n\n    /* Personalización de la barra de desplazamiento */\n    #viewer-container::-webkit-scrollbar {\n      width: 10px;\n      height: 10px;\n    }\n    #viewer-container::-webkit-scrollbar-track {\n      background: var(--bg-dark);\n    }\n    #viewer-container::-webkit-scrollbar-thumb {\n      background: #334155;\n      border-radius: 5px;\n    }\n    #viewer-container::-webkit-scrollbar-thumb:hover {\n      background: #475569;\n    }\n\n    .pdf-page-canvas {\n      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);\n      border-radius: 4px;\n      background: white;\n      max-width: 100%;\n      height: auto !important;\n    }\n\n    /* Pantalla de carga */\n    #loader {\n      position: fixed;\n      inset: 0;\n      background: var(--bg-dark);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      gap: 15px;\n      z-index: 50;\n    }\n\n    .spinner {\n      width: 40px;\n      height: 40px;\n      border: 4px solid #334155;\n      border-top-color: var(--accent);\n      border-radius: 50%;\n      animation: spin 1s linear infinite;\n    }\n\n    @keyframes spin {\n      to { transform: rotate(360deg); }\n    }\n\n    /* Ocultar todo si intentan imprimir */\n    @media print {\n      body { display: none !important; }\n    }\n  </style>\n</head>\n<body oncontextmenu=\"return false;\">\n\n  <!-- Pantalla de carga inicial -->\n  <div id=\"loader\">\n    <div class=\"spinner\"></div>\n    <span style=\"color: #94a3b8; font-size: 0.9rem;\">Cargando documento seguro...</span>\n  </div>\n\n  <!-- Barra de herramientas superior -->\n  <div class=\"toolbar\">\n    <div class=\"file-info\">\n      <span class=\"badge\">SOLO LECTURA</span>\n      <span class=\"file-name\" title=\"{{FILE_NAME}}\">{{FILE_NAME}}</span>\n    </div>\n\n    <div class=\"controls\">\n      <button id=\"prev-page\" title=\"Página anterior\">◀</button>\n      <span class=\"page-indicator\">Pág. <span id=\"page-num\">1</span> / <span id=\"page-count\">-</span></span>\n      <button id=\"next-page\" title=\"Página siguiente\">▶</button>\n    </div>\n\n    <div class=\"controls\">\n      <button id=\"zoom-out\" title=\"Alejar\">➖</button>\n      <span class=\"zoom-indicator\" id=\"zoom-level\">120%</span>\n      <button id=\"zoom-in\" title=\"Acercar\">➕</button>\n    </div>\n  </div>\n\n  <!-- Área donde se dibujan las páginas -->\n  <div id=\"viewer-container\"></div>\n\n  <script>\n    // Bloquear atajos de teclado de descarga, impresión y guardado (Ctrl+S, Ctrl+P, Ctrl+U)\n    document.addEventListener('keydown', function(e) {\n      if ((e.ctrlKey || e.metaKey) && ['s', 'p', 'u', 'c'].includes(e.key.toLowerCase())) {\n        e.preventDefault();\n      }\n    });\n\n    // Configuración de PDF.js\n    const pdfjsLib = window['pdfjs-dist/build/pdf'];\n    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cloudflare.com';\n\n    const url = \"{{FILE_DATA_URL}}\";\n    let pdfDoc = null;\n    let scale = 1.2; // Zoom inicial\n    const container = document.getElementById('viewer-container');\n    const loader = document.getElementById('loader');\n\n    // Renderizar todas las páginas en cascada\n    async function renderAllPages() {\n      container.innerHTML = ''; // Limpiar contenedor\n      for (let num = 1; num <= pdfDoc.numPages; num++) {\n        const page = await pdfDoc.getPage(num);\n        const viewport = page.getViewport({ scale: scale });\n\n        const canvas = document.createElement('canvas');\n        canvas.className = 'pdf-page-canvas';\n        canvas.id = `page-${num}`;\n        const ctx = canvas.getContext('2d');\n\n        // Ajuste para pantallas Retina / Alta densidad\n        const outputScale = window.devicePixelRatio || 1;\n        canvas.width = Math.floor(viewport.width * outputScale);\n        canvas.height = Math.floor(viewport.height * outputScale);\n        canvas.style.width = Math.floor(viewport.width) + \"px\";\n\n        const transform = outputScale !== 1 ? [outputScale, 0, 0, outputScale, 0, 0] : null;\n\n        container.appendChild(canvas);\n\n        await page.render({\n          canvasContext: ctx,\n          transform: transform,\n          viewport: viewport\n        }).promise;\n      }\n      loader.style.display = 'none';\n    }\n\n    // Cargar el documento PDF\n    pdfjsLib.getDocument(url).promise.then(function(pdfDoc_) {\n      pdfDoc = pdfDoc_;\n      document.getElementById('page-count').textContent = pdfDoc.numPages;\n      renderAllPages();\n    }).catch(function(error) {\n      loader.innerHTML = `<span style=\"color: #ef4444;\">Error al cargar el PDF. Verifica el origen del archivo.</span>`;\n      console.error(error);\n    });\n\n    // Controles de Zoom\n    document.getElementById('zoom-in').addEventListener('click', () => {\n      if (scale >= 2.5) return;\n      scale += 0.2;\n      document.getElementById('zoom-level').textContent = Math.round(scale * 100) + '%';\n      renderAllPages();\n    });\n\n    document.getElementById('zoom-out').addEventListener('click', () => {\n      if (scale <= 0.6) return;\n      scale -= 0.2;\n      document.getElementById('zoom-level').textContent = Math.round(scale * 100) + '%';\n      renderAllPages();\n    });\n\n    // Navegación rápida entre páginas\n    let currentPage = 1;\n    function scrollToPage(num) {\n      const target = document.getElementById(`page-${num}`);\n      if (target) {\n        target.scrollIntoView({ behavior: 'smooth' });\n        currentPage = num;\n        document.getElementById('page-num').textContent = currentPage;\n      }\n    }\n\n    document.getElementById('prev-page').addEventListener('click', () => {\n      if (currentPage > 1) scrollToPage(currentPage - 1);\n    });\n\n    document.getElementById('next-page').addEventListener('click', () => {\n      if (pdfDoc && currentPage < pdfDoc.numPages) scrollToPage(currentPage + 1);\n    });\n\n    // Actualizar número de página al hacer scroll manual\n    container.addEventListener('scroll', () => {\n      if (!pdfDoc) return;\n      const canvases = document.querySelectorAll('.pdf-page-canvas');\n      canvases.forEach((canvas, index) => {\n        const rect = canvas.getBoundingClientRect();\n        if (rect.top >= 0 && rect.top <= window.innerHeight / 2) {\n          currentPage = index + 1;\n          document.getElementById('page-num').textContent = currentPage;\n        }\n      });\n    });\n  </script>\n</body>\n</html>\n"
  },
