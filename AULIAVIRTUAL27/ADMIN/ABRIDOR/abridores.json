    "id": 501,
    "ext": "pdf",
    "name": "Visor PDF Protegido (Sin descarga)",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>{{FILE_NAME}}</title>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js\"></script>\n  <style>\n    :root {\n      --bg-main: #0b1120;\n      --bg-bar: #111827;\n      --bg-panel: #1e293b;\n      --border: #334155;\n      --accent: #3b82f6;\n      --text: #f8fafc;\n      --text-muted: #94a3b8;\n    }\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: 'Inter', system-ui, -apple-system, sans-serif;\n      background: var(--bg-main);\n      color: var(--text);\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n      user-select: none;\n    }\n    .progress-track { height: 3px; width: 100%; background: #1e293b; }\n    .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #3b82f6, #38bdf8); transition: width 0.25s ease; }\n    .toolbar {\n      background: var(--bg-bar);\n      padding: 8px 14px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid var(--border);\n      gap: 10px;\n      flex-wrap: wrap;\n      z-index: 20;\n    }\n    .group { display: flex; align-items: center; gap: 6px; }\n    .file-title {\n      font-size: 13px; font-weight: 700; max-width: 250px;\n      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #e2e8f0;\n    }\n    button {\n      background: var(--bg-panel); color: var(--text); border: 1px solid #334155;\n      padding: 6px 10px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;\n      display: inline-flex; align-items: center; gap: 5px; transition: all 0.15s ease;\n    }\n    button:hover:not(:disabled) { background: #334155; border-color: #475569; }\n    button:disabled { opacity: 0.35; cursor: not-allowed; }\n    .page-pill {\n      background: #0f172a; border: 1px solid var(--border); padding: 4px 10px;\n      border-radius: 8px; font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 4px;\n    }\n    .page-pill input {\n      width: 36px; background: transparent; border: none; color: #38bdf8;\n      font-weight: 700; text-align: center; font-size: 12px; outline: none;\n    }\n    .workspace { flex: 1; display: flex; overflow: hidden; position: relative; }\n    .sidebar {\n      width: 175px; background: #0f172a; border-right: 1px solid var(--border);\n      overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 12px;\n      transition: width 0.2s ease, padding 0.2s ease;\n    }\n    .sidebar.collapsed { width: 0; padding: 0; border: none; overflow: hidden; }\n    .thumb-card {\n      background: #1e293b; border: 2px solid transparent; border-radius: 8px;\n      padding: 6px; cursor: pointer; text-align: center; transition: all 0.15s;\n    }\n    .thumb-card:hover { border-color: #64748b; }\n    .thumb-card.active { border-color: var(--accent); background: #1e3a8a44; }\n    .thumb-card canvas { width: 100%; height: auto; border-radius: 4px; background: white; display: block; }\n    .thumb-label { font-size: 11px; color: var(--text-muted); margin-top: 5px; font-weight: 600; }\n    .viewer-container {\n      flex: 1; overflow: auto; display: flex; justify-content: center; align-items: flex-start;\n      padding: 28px; background-image: radial-gradient(#1e293b 1.2px, transparent 1.2px); background-size: 22px 22px;\n    }\n    .page-wrapper {\n      position: relative; display: none; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);\n      border-radius: 6px; overflow: hidden;\n    }\n    #pdf-canvas { display: block; background: white; }\n    .loading {\n      margin: auto; text-align: center; color: var(--text-muted); font-size: 14px;\n      display: flex; flex-direction: column; align-items: center; gap: 12px;\n    }\n    .spinner {\n      width: 34px; height: 34px; border: 3px solid #334155; border-top-color: var(--accent);\n      border-radius: 50%; animation: spin 0.8s linear infinite;\n    }\n    @keyframes spin { to { transform: rotate(360deg); } }\n    .toast {\n      position: fixed; bottom: 18px; right: 18px; background: #1e293b; border: 1px solid #475569;\n      color: #f8fafc; padding: 8px 14px; border-radius: 10px; font-size: 12px; font-weight: 600;\n      opacity: 0; transform: translateY(10px); transition: all 0.2s; pointer-events: none; z-index: 50;\n    }\n    .toast.show { opacity: 1; transform: translateY(0); }\n  </style>\n</head>\n<body oncontextmenu=\"return false;\">\n\n  <div class=\"progress-track\"><div class=\"progress-fill\" id=\"progress-fill\"></div></div>\n\n  <div class=\"toolbar\">\n    <div class=\"group\">\n      <button onclick=\"toggleSidebar()\">📑 Páginas</button>\n      <span class=\"file-title\">📄 {{FILE_NAME}}</span>\n    </div>\n\n    <div class=\"group\">\n      <button id=\"prev-page\" onclick=\"onPrevPage()\" disabled>◀</button>\n      <div class=\"page-pill\">\n        <input type=\"number\" id=\"page-input\" min=\"1\" value=\"1\" onchange=\"jumpToPage(this.value)\">\n        <span>/ <span id=\"page-count\">-</span></span>\n      </div>\n      <button id=\"next-page\" onclick=\"onNextPage()\" disabled>▶</button>\n    </div>\n\n    <div class=\"group\">\n      <button onclick=\"zoomOut()\">➖</button>\n      <span id=\"zoom-label\" style=\"font-size:12px;font-weight:700;min-width:42px;text-align:center;\">125%</span>\n      <button onclick=\"zoomIn()\">➕</button>\n      <button onclick=\"fitWidth()\">↔ Ancho</button>\n      <button onclick=\"rotateDoc()\">↻</button>\n    </div>\n\n    <div class=\"group\">\n      <button onclick=\"toggleFullscreen()\">⛶</button>\n    </div>\n  </div>\n\n  <div class=\"workspace\">\n    <aside class=\"sidebar\" id=\"sidebar\"></aside>\n    <main class=\"viewer-container\" id=\"viewer-container\">\n      <div id=\"loading-msg\" class=\"loading\">\n        <div class=\"spinner\"></div>\n        <span>Cargando documento PDF...</span>\n      </div>\n      <div class=\"page-wrapper\" id=\"page-wrapper\">\n        <canvas id=\"pdf-canvas\"></canvas>\n      </div>\n    </main>\n  </div>\n\n  <div class=\"toast\" id=\"toast\"></div>\n  <script id=\"raw-data\" type=\"text/plain\">{{FILE_DATA_URL}}</script>\n\n  <script>\n    let pdfDoc = null, pageNum = 1, pageRendering = false, pageNumPending = null, scale = 1.25, rotation = 0;\n    const canvas = document.getElementById('pdf-canvas'), ctx = canvas.getContext('2d');\n    const pageWrapper = document.getElementById('page-wrapper'), loadingMsg = document.getElementById('loading-msg');\n\n    function showToast(msg) {\n      const t = document.getElementById('toast');\n      t.textContent = msg; t.classList.add('show');\n      clearTimeout(t._timer);\n      t._timer = setTimeout(() => t.classList.remove('show'), 2000);\n    }\n\n    function initPdfViewer() {\n      const raw = document.getElementById('raw-data').textContent.trim();\n      if (!raw) return;\n      try {\n        const base64 = raw.includes(',') ? raw.split(',')[1].replace(/\\s/g, '') : raw.replace(/\\s/g, '');\n        const bytes = Uint8Array.from(atob(base64), c => c.charCodeAt(0));\n\n        pdfjsLib.getDocument({ data: bytes, disableWorker: true }).promise.then(async function(pdf) {\n          pdfDoc = pdf;\n          loadingMsg.style.display = 'none';\n          pageWrapper.style.display = 'block';\n          document.getElementById('page-count').textContent = pdf.numPages;\n          document.getElementById('page-input').max = pdf.numPages;\n          renderPage(pageNum);\n          buildThumbnails();\n        });\n      } catch (err) {\n        loadingMsg.innerHTML = `<span style=\"color:#f43f5e;\">Error al abrir el PDF</span>`;\n      }\n    }\n\n    function renderPage(num) {\n      pageRendering = true;\n      pdfDoc.getPage(num).then(function(page) {\n        const viewport = page.getViewport({ scale: scale, rotation: rotation });\n        canvas.height = viewport.height;\n        canvas.width = viewport.width;\n        page.render({ canvasContext: ctx, viewport: viewport }).promise.then(() => {\n          pageRendering = false;\n          if (pageNumPending !== null) { renderPage(pageNumPending); pageNumPending = null; }\n        });\n      });\n      document.getElementById('page-input').value = num;\n      document.getElementById('prev-page').disabled = (num <= 1);\n      document.getElementById('next-page').disabled = (num >= pdfDoc.numPages);\n      document.getElementById('zoom-label').textContent = Math.round(scale * 100) + '%';\n      document.getElementById('progress-fill').style.width = ((num / pdfDoc.numPages) * 100) + '%';\n      document.querySelectorAll('.thumb-card').forEach((el, idx) => el.classList.toggle('active', idx + 1 === num));\n    }\n\n    function queueRenderPage(num) { if (pageRendering) pageNumPending = num; else renderPage(num); }\n    function onPrevPage() { if (pageNum > 1) { pageNum--; queueRenderPage(pageNum); } }\n    function onNextPage() { if (pdfDoc && pageNum < pdfDoc.numPages) { pageNum++; queueRenderPage(pageNum); } }\n    function jumpToPage(val) {\n      let t = parseInt(val, 10);\n      if (!isNaN(t)) { pageNum = Math.max(1, Math.min(pdfDoc.numPages, t)); queueRenderPage(pageNum); }\n    }\n    function zoomIn() { scale = Math.min(3.0, +(scale + 0.2).toFixed(2)); queueRenderPage(pageNum); }\n    function zoomOut() { scale = Math.max(0.5, +(scale - 0.2).toFixed(2)); queueRenderPage(pageNum); }\n    function fitWidth() {\n      pdfDoc.getPage(pageNum).then(page => {\n        const w = document.getElementById('viewer-container').clientWidth - 70;\n        scale = Math.max(0.5, Math.min(2.5, +(w / page.getViewport({ scale: 1, rotation }).width).toFixed(2)));\n        queueRenderPage(pageNum);\n        showToast('Ajustado al ancho');\n      });\n    }\n    function rotateDoc() { rotation = (rotation + 90) % 360; queueRenderPage(pageNum); }\n    async function buildThumbnails() {\n      const sidebar = document.getElementById('sidebar');\n      sidebar.innerHTML = '';\n      for (let i = 1; i <= Math.min(pdfDoc.numPages, 30); i++) {\n        const card = document.createElement('div');\n        card.className = 'thumb-card' + (i === 1 ? ' active' : '');\n        card.onclick = () => { pageNum = i; queueRenderPage(i); };\n        const tc = document.createElement('canvas');\n        card.appendChild(tc);\n        card.appendChild(Object.assign(document.createElement('div'), {className: 'thumb-label', textContent: `Pág ${i}`}));\n        sidebar.appendChild(card);\n        const p = await pdfDoc.getPage(i), vp = p.getViewport({ scale: 0.22 });\n        tc.width = vp.width; tc.height = vp.height;\n        await p.render({ canvasContext: tc.getContext('2d'), viewport: vp }).promise;\n      }\n    }\n    function toggleSidebar() { document.getElementById('sidebar').classList.toggle('collapsed'); }\n    function toggleFullscreen() { if (!document.fullscreenElement) document.documentElement.requestFullscreen(); else document.exitFullscreen(); }\n    initPdfViewer();\n  </script>\n</body>\n</html>"
  },
