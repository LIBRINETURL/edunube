    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>{{FILE_NAME}}</title>\n  <!-- Incluimos PDF.js y su worker desde CDN oficial -->\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js\"></script>\n  <script>\n    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';\n  </script>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: system-ui, -apple-system, sans-serif;\n      background: #0f172a;\n      color: #f8fafc;\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n    }\n    .toolbar {\n      background: #1e293b;\n      padding: 10px 16px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid #334155;\n      gap: 12px;\n      z-index: 10;\n    }\n    .file-title {\n      font-size: 13px;\n      font-weight: 600;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      max-width: 35%;\n    }\n    .controls {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n    button, a.btn {\n      background: #334155;\n      color: #f8fafc;\n      border: none;\n      padding: 6px 12px;\n      border-radius: 7px;\n      font-size: 12px;\n      font-weight: 600;\n      cursor: pointer;\n      text-decoration: none;\n    }\n    button:hover, a.btn:hover { background: #475569; }\n    button:disabled { opacity: 0.4; cursor: not-allowed; }\n    .btn-primary { background: #0f6cbf; }\n    .btn-primary:hover { background: #0a4f8a; }\n    .viewer-container {\n      flex: 1;\n      display: flex;\n      justify-content: center;\n      align-items: flex-start;\n      overflow: auto;\n      padding: 24px;\n      background-image: radial-gradient(#334155 1px, transparent 1px);\n      background-size: 20px 20px;\n    }\n    canvas {\n      box-shadow: 0 15px 35px rgba(0,0,0,0.5);\n      border-radius: 4px;\n      background: white;\n      max-width: 100%;\n    }\n    .loading {\n      margin: auto;\n      text-align: center;\n      color: #94a3b8;\n      font-size: 14px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"toolbar\">\n    <span class=\"file-title\">📄 {{FILE_NAME}}</span>\n    <div class=\"controls\">\n      <button id=\"prev-page\" onclick=\"onPrevPage()\">◀ Anterior</button>\n      <span style=\"font-size: 12px; font-weight: 600;\" id=\"page-info\">Pág: - / -</span>\n      <button id=\"next-page\" onclick=\"onNextPage()\">Siguiente ▶</button>\n      <button onclick=\"zoomOut()\">➖</button>\n      <button onclick=\"zoomIn()\">➕</button>\n      <a id=\"download-btn\" class=\"btn btn-primary\" download=\"{{FILE_NAME}}\">⬇ Descargar</a>\n    </div>\n  </div>\n\n  <div class=\"viewer-container\" id=\"viewer-container\">\n    <div id=\"loading-msg\" class=\"loading\">Cargando motor PDF.js...</div>\n    <canvas id=\"pdf-canvas\"></canvas>\n  </div>\n\n  <!-- Contenido en Base64 inyectado por el servidor de datos -->\n  <script id=\"raw-data\" type=\"text/plain\">{{FILE_DATA_URL}}</script>\n\n  <script>\n    let pdfDoc = null;\n    let pageNum = 1;\n    let pageRendering = false;\n    let pageNumPending = null;\n    let scale = 1.2;\n    const canvas = document.getElementById('pdf-canvas');\n    const ctx = canvas.getContext('2d');\n\n    const dataUrl = document.getElementById('raw-data').textContent.trim();\n    \n    if (dataUrl && dataUrl.includes(',')) {\n      // Convertir Base64 a Uint8Array de forma limpia\n      const base64 = dataUrl.split(',')[1];\n      const binaryString = atob(base64);\n      const len = binaryString.length;\n      const bytes = new Uint8Array(len);\n      for (let i = 0; i < len; i++) {\n        bytes[i] = binaryString.charCodeAt(i);\n      }\n\n      // Enlace directo de respaldo para descarga\n      const blob = new Blob([bytes], { type: 'application/pdf' });\n      document.getElementById('download-btn').href = URL.createObjectURL(blob);\n\n      // Cargar con PDF.js\n      pdfjsLib.getDocument({ data: bytes }).promise.then(function(pdfDoc_) {\n        pdfDoc = pdfDoc_;\n        document.getElementById('loading-msg').style.display = 'none';\n        document.getElementById('page-info').textContent = `Pág: 1 / ${pdfDoc.numPages}`;\n        renderPage(pageNum);\n      }).catch(err => {\n        document.getElementById('loading-msg').innerHTML = `<span style=\"color:#f43f5e;\">Error al decodificar PDF: ${err.message}</span>`;\n      });\n    } else {\n      document.getElementById('loading-msg').innerHTML = `<span style=\"color:#f43f5e;\">Archivo PDF vacío o no disponible.</span>`;\n    }\n\n    function renderPage(num) {\n      pageRendering = true;\n      pdfDoc.getPage(num).then(function(page) {\n        const viewport = page.getView"
  },
