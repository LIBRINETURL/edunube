  {
    "id": 1795803691677,
    "ext": "html",
    "name": "html",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Visor: {{FILE_NAME}}</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      font-family: system-ui, -apple-system, sans-serif;\n      background-color: #1e1e1e;\n      color: #ffffff;\n      display: flex;\n      flex-direction: column;\n      height: 100vh;\n      overflow: hidden;\n      /* Evita selección de texto en la interfaz */\n      user-select: none; \n    }\n    header {\n      background-color: #2d2d2d;\n      padding: 12px 20px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 1px solid #404040;\n    }\n    .file-title {\n      font-size: 16px;\n      font-weight: 600;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n    .badge {\n      background-color: #d9534f;\n      font-size: 12px;\n      padding: 4px 8px;\n      border-radius: 4px;\n      font-weight: bold;\n    }\n    #viewer-container {\n      flex: 1;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      position: relative;\n      width: 100%;\n      height: 100%;\n    }\n    iframe, embed, img {\n      width: 100%;\n      height: 100%;\n      border: none;\n      object-fit: contain;\n    }\n    /* Capa invisible sobre imágenes para dificultar arrastrar/guardar */\n    .shield {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      z-index: 10;\n    }\n  </style>\n</head>\n<!-- Bloquea el clic derecho en todo el documento -->\n<body oncontextmenu=\"return false;\">\n\n  <header>\n    <div class=\"file-title\">📄 {{FILE_NAME}}</div>\n    <span class=\"badge\">Solo lectura</span>\n  </header>\n\n  <main id=\"viewer-container\">\n    <!-- El contenido se inyecta dinámicamente mediante JavaScript -->\n  </main>\n\n  <script>\n    const fileDataUrl = \"{{FILE_DATA_URL}}\";\n    const fileName = \"{{FILE_NAME}}\";\n    const container = document.getElementById(\"viewer-container\");\n\n    // Detectar si es imagen o documento (PDF, texto, etc.)\n    const isImage = fileDataUrl.startsWith(\"data:image/\") || /\\.(jpg|jpeg|png|gif|webp|svg)$/i.test(fileName);\n\n    if (isImage) {\n      const img = document.createElement(\"img\");\n      img.src = fileDataUrl;\n      img.alt = fileName;\n      img.draggable = false;\n\n      // Escudo transparente para evitar guardar imagen\n      const shield = document.createElement(\"div\");\n      shield.className = \"shield\";\n\n      container.appendChild(img);\n      container.appendChild(shield);\n    } else {\n      // Para PDF: añade #toolbar=0 para ocultar botones de descarga e impresión\n      const cleanUrl = fileDataUrl.includes(\"#\") \n        ? `${fileDataUrl}&toolbar=0&navpanes=0` \n        : `${fileDataUrl}#toolbar=0&navpanes=0`;\n\n      const iframe = document.createElement(\"iframe\");\n      iframe.src = cleanUrl;\n      // Restringe permisos dentro del iframe\n      iframe.setAttribute(\"sandbox\", \"allow-scripts allow-same-origin\");\n      container.appendChild(iframe);\n    }\n\n    // Bloquear atajos de teclado comunes (Ctrl+S, Ctrl+P, Ctrl+U)\n    document.addEventListener(\"keydown\", function(e) {\n      if ((e.ctrlKey || e.metaKey) && [\"s\", \"p\", \"u\", \"c\"].includes(e.key.toLowerCase())) {\n        e.preventDefault();\n      }\n    });\n  </script>\n\n</body>\n</html>\n"
  }
]