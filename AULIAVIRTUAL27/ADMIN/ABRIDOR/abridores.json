    "id": 502,
    "ext": "png",
    "name": "Visor de Imagen Protegida",
    "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>{{FILE_NAME}}</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: system-ui, -apple-system, sans-serif;\n      background: #0f172a;\n      color: #f8fafc;\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n      user-select: none;\n    }\n    .toolbar {\n      background: #1e293b;\n      padding: 10px 16px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid #334155;\n      gap: 10px;\n      z-index: 10;\n    }\n    .file-name {\n      font-size: 13px;\n      font-weight: 600;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      white-space: nowrap;\n      max-width: 50%;\n    }\n    .controls {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    button {\n      background: #334155;\n      color: #f8fafc;\n      border: none;\n      padding: 6px 11px;\n      border-radius: 7px;\n      font-size: 12px;\n      font-weight: 600;\n      cursor: pointer;\n    }\n    button:hover { background: #475569; }\n    .canvas {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: auto;\n      padding: 20px;\n      background-image: radial-gradient(#334155 1px, transparent 1px);\n      background-size: 20px 20px;\n    }\n    img {\n      max-width: 100%;\n      max-height: 100%;\n      object-fit: contain;\n      transition: transform 0.2s ease;\n      box-shadow: 0 10px 25px rgba(0,0,0,0.5);\n      border-radius: 4px;\n      pointer-events: none;\n    }\n  </style>\n</head>\n<body oncontextmenu=\"return false;\">\n  <div class=\"toolbar\">\n    <span class=\"file-name\">🖼️ {{FILE_NAME}}</span>\n    <div class=\"controls\">\n      <button onclick=\"zoom(-0.2)\">➖</button>\n      <button onclick=\"resetView()\">100%</button>\n      <button onclick=\"zoom(0.2)\">➕</button>\n      <button onclick=\"rotate()\">↻ Rotar</button>\n    </div>\n  </div>\n\n  <div class=\"canvas\">\n    <img id=\"preview-img\" alt=\"{{FILE_NAME}}\" draggable=\"false\">\n  </div>\n\n  <script id=\"raw-data\" type=\"text/plain\">{{FILE_DATA_URL}}</script>\n\n  <script>\n    let scale = 1;\n    let rotation = 0;\n    const img = document.getElementById('preview-img');\n    const dataUrl = document.getElementById('raw-data').textContent.trim();\n\n    if (dataUrl) {\n      img.src = dataUrl;\n    }\n\n    function updateTransform() {\n      img.style.transform = `scale(${scale}) rotate(${rotation}deg)`;\n    }\n    function zoom(delta) {\n      scale = Math.max(0.2, Math.min(4, scale + delta));\n      updateTransform();\n    }\n    function rotate() {\n      rotation = (rotation + 90) % 360;\n      updateTransform();\n    }\n    function resetView() {\n      scale = 1;\n      rotation = 0;\n      updateTransform();\n    }\n  </script>\n</body>\n</html>"
  }
