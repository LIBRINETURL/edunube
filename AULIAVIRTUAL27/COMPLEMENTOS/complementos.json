[
  {
    "id": 701,
    "icon": "🧩",
    "name": "Ficha Interactiva con Envío Automático",
    "description": "Complemento personalizado que registra la nota y envía un mensaje directo al terminar y pulsar Enviar.",
    "configPrompt": "Escribe las preguntas o enunciado de la ficha para el estudiante:",
    "code": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body { font-family: system-ui, sans-serif; background: #f8fafc; color: #0f172a; padding: 24px; max-width: 720px; margin: 0 auto; }\n  .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 24px; box-shadow: 0 2px 10px rgba(0,0,0,.04); }\n  h2 { margin-top: 0; color: #0f6cbf; }\n  .enunciado { background: #eef6fc; border-left: 4px solid #0f6cbf; padding: 14px; border-radius: 8px; margin: 16px 0; white-space: pre-wrap; }\n  textarea { width: 100%; min-height: 140px; padding: 12px; border: 1px solid #cbd5e1; border-radius: 10px; font-family: inherit; font-size: 14px; box-sizing: border-box; }\n  button { margin-top: 14px; background: #0f6cbf; color: #fff; border: 0; padding: 10px 20px; border-radius: 10px; font-weight: 600; cursor: pointer; }\n  button:hover { background: #0a4f8a; }\n  #ok { display: none; margin-top: 12px; color: #059669; font-weight: 600; }\n</style>\n</head>\n<body>\n  <div class=\"card\">\n    <h2>{{TITULO}}</h2>\n    <p>{{DESCRIPCION}}</p>\n    <div class=\"enunciado\">{{CONFIG_DATA}}</div>\n    <textarea id=\"resp\" placeholder=\"Completa la ficha aquí...\"></textarea>\n    <button onclick=\"enviarFicha()\">Enviar ficha</button>\n    <p id=\"ok\">¡Ficha enviada! Se ha registrado la nota y enviado el mensaje.</p>\n  </div>\n  <script>\n    function enviarFicha() {\n      const texto = document.getElementById('resp').value.trim();\n      window.parent.postMessage({\n        type: 'AULIA_SUBMIT',\n        score: 10,\n        maxScore: 10,\n        answers: { respuestaAlumno: texto || 'Ficha completada' },\n        sendMessage: true,\n        messageTitle: 'Ficha completada: {{TITULO}}',\n        messageBody: 'El estudiante ha terminado la ficha \"{{TITULO}}\" y ha pulsado Enviar.\\nRespuesta: ' + (texto || 'Sin texto adicional')\n      }, '*');\n      document.getElementById('ok').style.display = 'block';\n    }\n  </script>\n</body>\n</html>"
  }
]