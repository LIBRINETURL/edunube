  {
    "id": 701,
    "icon": "📝",
    "name": "Tarea de Redacción / Entrega Abierta",
    "description": "Permite al alumno responder a un enunciado libre y enviar su texto o reflexión al profesor.",
    "configPrompt": "Escribe el enunciado o pregunta principal de la tarea para los estudiantes:",
    "code": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body { font-family: system-ui, sans-serif; background: #f8fafc; color: #0f172a; padding: 24px; max-width: 720px; margin: 0 auto; }\n  .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 24px; box-shadow: 0 2px 10px rgba(0,0,0,.04); }\n  h2 { margin-top: 0; color: #0f6cbf; }\n  .enunciado { background: #eef6fc; border-left: 4px solid #0f6cbf; padding: 14px; border-radius: 8px; margin: 16px 0; white-space: pre-wrap; }\n  textarea { width: 100%; min-height: 150px; padding: 12px; border: 1px solid #cbd5e1; border-radius: 10px; font-family: inherit; font-size: 14px; box-sizing: border-box; }\n  button { margin-top: 14px; background: #0f6cbf; color: #fff; border: 0; padding: 10px 20px; border-radius: 10px; font-weight: 600; cursor: pointer; }\n  button:hover { background: #0a4f8a; }\n  #ok { display: none; margin-top: 12px; color: #059669; font-weight: 600; }\n</style>\n</head>\n<body>\n  <div class=\"card\">\n    <h2>{{TITULO}}</h2>\n    <p>{{DESCRIPCION}}</p>\n    <div class=\"enunciado\">{{CONFIG_DATA}}</div>\n    <textarea id=\"resp\" placeholder=\"Escribe aquí tu respuesta o desarrollo...\"></textarea>\n    <button onclick=\"enviar()\">Enviar respuesta al profesor</button>\n    <p id=\"ok\">¡Respuesta enviada correctamente!</p>\n  </div>\n  <script>\n    function enviar() {\n      const texto = document.getElementById('resp').value.trim();\n      if (!texto) return;\n      window.parent.postMessage({\n        type: 'AULIA_SUBMIT',\n        score: 10,\n        maxScore: 10,\n        answers: { respuestaAlumno: texto }\n      }, '*');\n      document.getElementById('ok').style.display = 'block';\n    }\n  </script>\n</body>\n</html>"
  }
]